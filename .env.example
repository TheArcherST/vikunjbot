# Telegram bot token, obtained from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional HTTP/SOCKS proxy for all Telegram Bot API requests.
# Examples: http://proxy.example:8080 or socks5://user:password@proxy.example:1080
TELEGRAM_PROXY_URL=

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes already stored user tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Internal address used by user-created Vikunja webhooks.
RELAY_WEBHOOK_URL=http://vikunjbot-event-relay:8080/events

# Vikunja REST API, without a trailing slash.
VIKUNJA_API_URL=http://vikunja:3456/api/v2

# Optional API token of the dedicated, read-only `vikunjbot` Vikunja account.
# It is used only to enrich incomplete event payloads, never for user actions.
VIKUNJBOT_SERVICE_TOKEN=
